{
  "name": "GameBanner",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "target_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "display_duration": {
      "type": "number",
      "default": 5,
      "description": "Czas odliczania w sekundach"
    }
  },
  "required": [
    "title"
  ]
}