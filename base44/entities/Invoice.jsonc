{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "invoice_type": {
      "type": "string",
      "enum": [
        "b2c",
        "b2b"
      ],
      "default": "b2c"
    },
    "company_name": {
      "type": "string"
    },
    "company_nip": {
      "type": "string"
    },
    "company_address": {
      "type": "string"
    },
    "items": {
      "type": "string",
      "description": "JSON z pozycjami"
    },
    "subtotal": {
      "type": "number"
    },
    "vat_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "paid",
        "cancelled",
        "corrected"
      ],
      "default": "draft"
    },
    "payment_method": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Czy faktury s\u0105 w\u0142\u0105czone"
    }
  },
  "required": [
    "user_id",
    "total"
  ]
}