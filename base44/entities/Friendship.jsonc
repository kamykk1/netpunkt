{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "requester_id": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "addressee_id": {
      "type": "string"
    },
    "addressee_email": {
      "type": "string"
    },
    "addressee_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "requester_id",
    "addressee_id"
  ]
}