{
  "name": "PartnerProgram",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "Identyfikator: systempartnerski, mylead, vivnetwork, superpartners, temu, aliexpress"
    },
    "api_url": {
      "type": "string"
    },
    "api_key": {
      "type": "string"
    },
    "api_secret": {
      "type": "string"
    },
    "points_multiplier": {
      "type": "number",
      "default": 1,
      "description": "Mno\u017cnik punkt\u00f3w za akcj\u0119"
    },
    "is_enabled": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "commission_type": {
      "type": "string",
      "enum": [
        "cpa",
        "cps",
        "cpl",
        "revshare"
      ],
      "default": "cpa"
    },
    "default_points_per_action": {
      "type": "number",
      "default": 100
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}