{
  "name": "GameReport",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "reporter_email": {
      "type": "string"
    },
    "reported_user_id": {
      "type": "string"
    },
    "reported_user_login": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "game_type": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "resolved"
      ],
      "default": "new"
    },
    "admin_action": {
      "type": "string"
    },
    "chat_blocked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "reporter_id",
    "reported_user_id",
    "reason"
  ]
}